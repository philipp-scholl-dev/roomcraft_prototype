    "test:e2e": "node --test tests/e2e/tier1_features.test.js tests/e2e/tier2_boundaries.test.js tests/e2e/tier3_combinations.test.js tests/e2e/tier4_scenarios.test.js",
    "test:visual": "node tests/visual_tour.js"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
